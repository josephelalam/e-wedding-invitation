{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"name": "einvite",
	"compatibility_date": "2026-07-26",
	"compatibility_flags": ["nodejs_compat"],
	"main": ".svelte-kit/cloudflare/_worker.js",
	"triggers": {
		"crons": ["0 2 * * *"]
	},
	"vars": {
		"ORIGIN": "https://einvite.einvite.workers.dev"
	},
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare"
	},
	"workers_dev": true,
	"preview_urls": true,
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "einvite-db",
			"database_id": "94916ac6-a0c2-450b-ac83-bc76baf45ec7",
			"migrations_dir": "drizzle"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "einvite-media"
		}
	],
	"observability": {
		"enabled": true
	}
}
